# Required — random 32+ chars (openssl rand -base64 32)
BETTER_AUTH_SECRET=
# Public URL of the app
BETTER_AUTH_URL=http://localhost:3000
# Other URLs pilots use to reach it (LAN IP, Tailscale…), comma-separated
TRUSTED_ORIGINS=

# Other pilots need this code to sign up (the first account doesn't)
INVITE_CODE=

# DJI Open API key ("SDK key") — decrypts DJI Fly logs v13+.
# developer.dji.com → Create App → App Type: Open API
DJI_API_KEY=

# Local Node storage. The supplied Compose file overrides both paths to /data.
# Custom Node deployments may also use a Turso/libsql URL.
DATABASE_URL=file:./data/hiko.db
DATABASE_AUTH_TOKEN=
# Raw logs are archived here
DATA_DIR=./data

# Optional Docker overrides (defaults are shown):
# HIKO_IMAGE=ghcr.io/eliemada/hiko:0.1.0-beta.1
# HIKO_BIND=127.0.0.1
# HIKO_PORT=3000
