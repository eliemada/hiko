{
  "name": "hiko",
  "version": "0.1.0-beta.2",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/start-standalone.mjs",
    "lint": "eslint --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "e2e": "playwright test",
    "postinstall": "node scripts/copy-maplibre-worker.mjs",
    "setup:local": "node scripts/setup.mjs --local",
    "setup:docker": "node scripts/setup.mjs --docker",
    "demo:build": "tsx scripts/build-demo.mts",
    "demo:serve": "node scripts/serve-demo.mjs",
    "test:demo": "playwright test --config playwright.demo.config.ts",
    "test:container": "node scripts/container-smoke.mjs",
    "media": "node scripts/capture-media.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@photostructure/tz-lookup": "^11.7.0",
    "@react-pdf/renderer": "^4.9.0",
    "better-auth": "^1.7.12",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "dji-log-parser-js": "^0.5.7",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.61.0",
    "maplibre-gl": "^6.15.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "recharts": "^3.8.0",
    "signature_pad": "^5.1.4",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "@next/env": "16.4.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^26.6.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.5",
    "auth": "^1.7.12",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "shadcn": "^4.22.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "description": "A self-hosted drone logbook for pilots flying in Japan",
  "license": "MIT",
  "author": "Elie BRUNO",
  "repository": {
    "type": "git",
    "url": "https://github.com/eliemada/hiko.git"
  },
  "homepage": "https://eliemada.github.io/hiko/",
  "bugs": {
    "url": "https://github.com/eliemada/hiko/issues"
  },
  "engines": {
    "node": "^24.0.0 || ^26.0.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  },
  "type": "module"
